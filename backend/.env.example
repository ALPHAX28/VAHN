# ============================================================
# VAHN Backend Environment Configuration
# ============================================================

# Database Connection URI
DATABASE_URL=postgresql+pg8000://vahn_user:vahn_pass@localhost:5432/vahn_db

# Postgres connection credentials (for scripts/helpers)
DB_USER=vahn_user
DB_PASSWORD=vahn_pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vahn_db

# Backend server configurations
HOST=0.0.0.0
PORT=8000

# Authentication & Security
JWT_SECRET=your_production_secret_jwt_key

# Amazon SES Email Configuration
AWS_SES_REGION=ap-south-1
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_smtp_user
SMTP_PASSWORD=your_ses_smtp_password
EMAILS_FROM_EMAIL=noreply@vahnsports.com
EMAILS_FROM_NAME=VAHN Official

# Admin Panel Security
ADMIN_REGISTRATION_SECRET=your_admin_registration_secret

# Storage Provider & AWS S3
STORAGE_PROVIDER=s3
AWS_BUCKET_NAME=vahn
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_REGION=ap-south-1
