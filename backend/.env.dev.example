# ============================================================
# VAHN Development Environment Configuration (dev.vahnsports.com)
# ============================================================

# Database Connection URI (Isolated Dev Database)
DATABASE_URL=postgresql+pg8000://vahn_dev_user:vahn_dev_pass@db-dev:5432/vahn_dev_db

# Postgres connection credentials (for scripts/helpers)
DB_USER=vahn_dev_user
DB_PASSWORD=vahn_dev_pass
DB_HOST=db-dev
DB_PORT=5432
DB_NAME=vahn_dev_db

# Backend server configurations
HOST=0.0.0.0
PORT=8000

# Authentication & Security (Distinct Dev JWT Secret)
JWT_SECRET=vahn_dev_secret_jwt_key_2026_isolated_dev_environment_777

# Brevo SMTP Email Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=arnabdutta8986@gmail.com
EMAILS_FROM_NAME=Vahn Dev

# Admin Panel Security
ADMIN_REGISTRATION_SECRET=vahn-admin-secret-2026

# Storage Provider & AWS S3 (Isolated Dev Prefix: dev/...)
STORAGE_PROVIDER=s3
AWS_BUCKET_NAME=vahn
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_REGION=ap-south-2
S3_FOLDER_PREFIX=dev
