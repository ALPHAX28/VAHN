# ============================================================
# Caddyfile — Reverse Proxy for Production & Development
# ============================================================

{
    email abhinandan.mitra@vahnsports.com
}

# 1. Production Domain (https://vahnsports.com)
vahnsports.com, www.vahnsports.com {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API Endpoints (FastAPI Prod)
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Frontend Storefront & Admin (Next.js Prod)
    handle {
        reverse_proxy frontend:3000
    }
}

# 2. Development Domain (https://dev.vahnsports.com)
dev.vahnsports.com {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API Endpoints (FastAPI Dev)
    handle /api/* {
        reverse_proxy vahn-backend-dev:8000
    }

    # Frontend Storefront & Admin (Next.js Dev)
    handle {
        reverse_proxy vahn-frontend-dev:3000
    }
}

# 3. Direct IP Access (HTTP)
http://65.2.203.191 {
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
