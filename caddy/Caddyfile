# ============================================================
# Caddyfile — Reverse Proxy for Production & Development
# ============================================================
{
	email abhinandan.mitra@vahnsports.com
}

# 1. Production Storefront (https://vahnsports.com)
vahnsports.com, www.vahnsports.com {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# API Endpoints (FastAPI Prod)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Frontend Storefront (Next.js Prod)
	handle {
		reverse_proxy frontend:3000
	}
}

# 2. Production Admin Subdomain (https://admin.vahnsports.com) — VPN RESTRICTED
admin.vahnsports.com {
	encode gzip zstd

	# ── VAHN IN-HOUSE VPN ACCESS CONTROL ──
	# Only allow connections originating from WireGuard VPN (10.8.0.0/24) or local server
	@not_vpn not remote_ip 10.8.0.0/24 127.0.0.1 65.2.203.191
	handle @not_vpn {
		respond "Access Denied: VAHN Internal VPN Required. Please connect to VAHN WireGuard VPN." 403
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# API Endpoints (FastAPI Prod)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Frontend Admin (Next.js Prod)
	handle {
		reverse_proxy frontend:3000
	}
}

