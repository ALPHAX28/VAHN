# ============================================================
# Caddyfile — Production Reverse Proxy for vahnsports.com
# Automatic HTTPS via Let's Encrypt / ZeroSSL + HTTP/3 + Gzip
# ============================================================

{
    email arnabdutta8986@gmail.com
}

vahnsports.com, www.vahnsports.com {
    encode gzip zstd

    # Enhanced Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Backend API Endpoints (FastAPI)
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Frontend Storefront & Admin (Next.js)
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
