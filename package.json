{
  "name": "vahn-sports-standalone",
  "version": "1.0.0",
  "description": "Bespoke standalone decoupled e-commerce site for VAHN Sports",
  "scripts": {
    "setup:docker": "node setup_docker.js",
    "dev:docker": "node run_dev.js",
    "clean:next": "node -e \"require('fs').rmSync('./frontend/.next',{recursive:true,force:true});console.log('Cleaned .next')\"",
    "prod:start": "node run_prod.js",
    "prod:docker": "docker-compose -p prod-vahn -f docker-compose.prod.yml up --build",
    "logs:start": "docker compose -f docker-compose.logging.yml up -d",
    "logs:stop": "docker compose -f docker-compose.logging.yml down",
    "logs:status": "docker compose -f docker-compose.logging.yml ps"
  },
  "keywords": [
    "nextjs",
    "fastapi",
    "postgresql",
    "docker",
    "alembic"
  ],
  "author": "Antigravity",
  "license": "ISC"
}
